{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // No Node types: src/ may only use what every runtime has (decision 0004), as declared in
    // src/globals.d.ts.
    "types": [],
    // So tsc checks src/globals.d.ts itself, which ESLint skips. With no types loaded, this
    // checks no third-party declarations.
    "skipLibCheck": false,
    "paths": {},
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": []
}
