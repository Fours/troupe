{
  // Editor and test config: src, tests and examples, with Node types for the tests.
  // tsconfig.build.json builds src/ without Node types, which keeps the core runtime-agnostic
  // (decision 0004). `npm run typecheck` runs both.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    // Node runs examples/ by stripping types, which needs relative imports to end in .ts.
    "allowImportingTsExtensions": true,
    // Lets examples and tests import the package by name before dist/ is built.
    "paths": {
      "@kylewillett/troupe": ["./src/index.ts"],
      "@kylewillett/troupe/testkit": ["./src/testkit/index.ts"],
      "@kylewillett/troupe/persistence": ["./src/persistence/index.ts"],
      "@kylewillett/troupe/persistence/sqlite": ["./src/node/sqlite/index.ts"],
      "@kylewillett/troupe/persistence/postgres": ["./src/persistence/postgres/index.ts"],
      "@kylewillett/troupe/backstage": ["./src/backstage/index.ts"],
      "@kylewillett/troupe/backstage/ui": ["./backstage/src/ui-api.ts"],
      "@kylewillett/troupe/backstage/server": ["./src/node/backstage/index.ts"],
      "@kylewillett/troupe/cluster": ["./src/cluster/index.ts"],
      "@kylewillett/troupe/cluster/postgres": ["./src/cluster/postgres/index.ts"],
      "@kylewillett/troupe/cluster/tcp": ["./src/node/cluster/index.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "scripts",
    "bench",
    "demo/vite.config.ts",
    "demo/build",
    "backstage/vite.config.ts",
    "backstage/vite.ui.config.ts",
    "*.config.ts"
  ],
  // Node's types already declare these globals, and skipLibCheck would hide any clash, so the
  // editor and tests see only Node's. The build config puts the file back.
  "exclude": ["src/globals.d.ts", "e2e"]
}
