{
  "name": "@kylewillett/troupe",
  "version": "0.1.1",
  "description": "Typed actors for TypeScript: supervision, event-sourced persistent actors, and (later) cluster sharding.",
  "license": "MIT",
  "author": "Kyle Willett",
  "homepage": "https://troupe.kylewillett.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fours/troupe.git"
  },
  "bugs": {
    "url": "https://github.com/Fours/troupe/issues"
  },
  "keywords": [
    "actor",
    "actors",
    "actor-model",
    "akka",
    "supervision",
    "event-sourcing",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./persistence/sqlite": {
      "types": "./dist/node/sqlite/index.d.ts",
      "import": "./dist/node/sqlite/index.js"
    },
    "./persistence/postgres": {
      "types": "./dist/persistence/postgres/index.d.ts",
      "import": "./dist/persistence/postgres/index.js"
    },
    "./backstage": {
      "types": "./dist/backstage/index.d.ts",
      "import": "./dist/backstage/index.js"
    },
    "./backstage/server": {
      "types": "./dist/node/backstage/index.d.ts",
      "import": "./dist/node/backstage/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.node.json && node scripts/write-sql.ts && vite build --config backstage/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.build.node.json --noEmit && tsc -p demo/tsconfig.json && tsc -p backstage/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage --project unit --project integration",
    "postgres:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "postgres:down": "docker compose -f docker-compose.test.yml down",
    "example": "npm run build && node examples/box-office/main.ts",
    "example:backstage": "npm run build && node examples/backstage/main.ts",
    "bench": "node --expose-gc bench/run.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "test:e2e": "npm run build && npm run demo:build && playwright test",
    "check:package": "node scripts/check-pack.ts && publint && attw --pack --profile esm-only",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.454.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
